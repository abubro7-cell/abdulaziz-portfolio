<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mening shaxsiy saytim</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  color: white;
  background: linear-gradient(135deg, #18002e, #6c2bd9, #e879f9);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.container {
  padding: 40px 25px;
  max-width: 650px;
  animation: paydo 1.2s ease;
}

h1 {
  font-size: 46px;
  margin-bottom: 15px;
}

p {
  font-size: 19px;
  line-height: 1.7;
}

button {
  background: white;
  color: #7025c9;
  border: none;
  padding: 15px 30px;
  border-radius: 30px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 20px;
  transition: 0.3s;
}

button:hover {
  transform: scale(1.08);
  box-shadow: 0 0 25px #ffffff80;
}

#xabar {
  margin-top: 25px;
  font-size: 20px;
  font-weight: bold;
}

@keyframes paydo {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>
</head>
</body>
</html>